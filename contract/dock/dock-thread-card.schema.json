{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-dock.local/contract/dock/dock-thread-card.schema.json",
  "title": "Codex Dock Thread Card Stream",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "view",
    "epoch",
    "seq"
  ],
  "properties": {
    "kind": {
      "enum": [
        "snapshot",
        "delta",
        "heartbeat"
      ]
    },
    "schemaVersion": {
      "const": 2
    },
    "view": {
      "enum": [
        "dock",
        "archive"
      ]
    },
    "complete": {
      "type": "boolean",
      "description": "True only when the emitted ordering window is fully proven by the relay card projection. If any emitted card has unproven canonical activity, the stream must be incomplete."
    },
    "totalRows": {
      "type": "integer",
      "minimum": 0
    },
    "window": {
      "$ref": "#/$defs/window"
    },
    "stateGeneration": {
      "type": "integer",
      "minimum": 0
    },
    "epoch": {
      "type": "string",
      "minLength": 1
    },
    "baseSeq": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "asOf": {
      "type": "string"
    },
    "freshness": {
      "$ref": "#/$defs/freshness",
      "description": "Relay-owned freshness for the stream. Transport reachability alone must not mark card data fresh."
    },
    "hosts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/host"
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "upsertHosts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/host"
      }
    },
    "upsertCards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "deleteCardIDs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "sessions"
        ]
      },
      {
        "required": [
          "upsertSessions"
        ]
      },
      {
        "required": [
          "deleteSessionIDs"
        ]
      },
      {
        "required": [
          "messageSummary"
        ]
      },
      {
        "required": [
          "messageUpdatedAt"
        ]
      }
    ]
  },
  "$defs": {
    "window": {
      "type": "object",
      "required": [
        "offset",
        "limit",
        "rowCount"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0
        },
        "nextOffset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "fresh",
            "stale",
            "offline",
            "error"
          ]
        },
        "lastAttemptAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastSyncAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastError": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "required": [
        "id",
        "logicalHostID"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "logicalHostID": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "required": [
        "id",
        "logicalHostID",
        "threadID",
        "backendSessionID",
        "hostDisplayName",
        "orderKey",
        "activityAt",
        "activityAtMs",
        "displaySummary",
        "title",
        "status",
        "sourceKind",
        "lane",
        "archiveState",
        "freshness",
        "completeness"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "logicalHostID": {
          "type": "string",
          "minLength": 1
        },
        "threadID": {
          "type": "string",
          "minLength": 1
        },
        "backendSessionID": {
          "type": "string",
          "minLength": 1
        },
        "hostDisplayName": {
          "type": "string",
          "minLength": 1
        },
        "hostEndpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "orderKey": {
          "type": "string",
          "minLength": 1,
          "description": "Relay-owned stable ordering key derived from canonical card activity. Clients may use it only as a tie-breaker after activity time."
        },
        "activityAt": {
          "type": "string",
          "minLength": 1,
          "description": "Relay-owned canonical card activity timestamp."
        },
        "activityAtMs": {
          "type": "integer",
          "description": "Relay-owned canonical card activity time in milliseconds. It must fold thread metadata, newest turns, and live activity when available."
        },
        "displaySummary": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "running",
            "needsInput",
            "needsApproval",
            "idle",
            "error",
            "dormant",
            "unknown"
          ]
        },
        "sourceKind": {
          "enum": [
            "human",
            "automation",
            "unknown"
          ]
        },
        "lane": {
          "enum": [
            "human",
            "agent",
            "unknown"
          ]
        },
        "relationship": {
          "enum": [
            "root",
            "forked",
            "spawned",
            "unknown"
          ]
        },
        "forkedFromID": {
          "type": [
            "string",
            "null"
          ]
        },
        "archiveState": {
          "enum": [
            "active",
            "archived",
            "unknown"
          ]
        },
        "freshness": {
          "enum": [
            "unknown",
            "fresh",
            "stale",
            "offline",
            "error"
          ],
          "description": "Relay-owned card freshness. A card with unproven canonical activity must not be emitted as fresh."
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "description": "Relay-owned proof state for card truth. complete means canonical activity was proven or bounded by the relay projection."
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "workingDirectory": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "summarySource": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
