{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-dock.local/contract/projection/thread-detail-snapshot.schema.json",
  "title": "Codex Dock Projection Snapshot: Thread Detail",
  "description": "Canonical Thread Detail projection snapshot emitted by thread/detail/read, thread/detail/subscribe, and thread/detail/resync.",
  "type": "object",
  "required": [
    "schemaVersion",
    "identityVersion",
    "projectionEngineVersion",
    "sourceHostID",
    "view",
    "threadID",
    "epoch",
    "seq",
    "generation",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "identityVersion": {
      "const": 1
    },
    "projectionEngineVersion": {
      "const": 1
    },
    "sourceHostID": {
      "type": "string",
      "minLength": 1
    },
    "view": {
      "const": "thread.detail"
    },
    "threadID": {
      "type": "string",
      "minLength": 1
    },
    "epoch": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "snapshotID": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "viewParamsKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "complete": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "activeTurnID": {
      "type": [
        "string",
        "null"
      ]
    },
    "order": {
      "type": [
        "string",
        "null"
      ]
    },
    "freshness": {
      "type": [
        "object",
        "null"
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "https://codex-dock.local/contract/projection/payloads/thread-detail-row.schema.json"
      }
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "events"
        ]
      },
      {
        "required": [
          "messages"
        ]
      }
    ]
  },
  "additionalProperties": false
}
