{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex-dock.local/contract/proof/controlled-simulator-matrix-report.schema.json",
  "title": "Codex Dock Controlled Simulator Matrix Report",
  "type": "object",
  "required": ["schemaVersion", "kind", "status", "generatedAt", "config", "summary", "scenarios", "findings"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "codex-dock-controlled-simulator-matrix-report" },
    "status": { "$ref": "#/definitions/status" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "config": {
      "type": "object",
      "required": ["requiredScenarios", "minPasses", "maxUiLagMs"],
      "additionalProperties": false,
      "properties": {
        "requiredScenarios": {
          "type": "array",
          "items": { "type": "string" }
        },
        "minPasses": { "type": "number" },
        "maxUiLagMs": { "type": "number" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["ok", "reportCount", "requiredScenarioCount", "passingScenarioCount", "missingScenarioCount", "failedScenarioCount", "findings"],
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "boolean" },
        "reportCount": { "type": "number" },
        "evaluatedReportCount": { "type": "number" },
        "requiredScenarioCount": { "type": "number" },
        "passingScenarioCount": { "type": "number" },
        "missingScenarioCount": { "type": "number" },
        "failedScenarioCount": { "type": "number" },
        "unexpectedScenarioCount": { "type": "number" },
        "maxObservedUiLagMs": { "type": ["number", "null"] },
        "findings": { "type": "number" }
      }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/definitions/proofValue" }
    },
    "unexpectedScenarios": {
      "type": "array",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/proofValue" }
    }
  },
  "definitions": {
    "status": { "enum": ["pass", "fail", "blocked", "not_run"] },
    "proofObjectPropertyName": {
      "anyOf": [
        { "$ref": "https://codex-dock.local/contract/proof/proof-field-name.schema.json" },
        { "$ref": "https://codex-dock.local/contract/proof/proof-route-name.schema.json" }
      ]
    },
    "proofValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/definitions/proofValue" }
        },
        {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/proofObjectPropertyName" },
          "additionalProperties": { "$ref": "#/definitions/proofValue" }
        }
      ]
    }
  }
}
