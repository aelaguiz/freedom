{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex-dock.local/contract/proof/sim-ui-dump.schema.json",
  "title": "Codex Dock Simulator UI Dump",
  "type": "object",
  "required": ["schemaVersion", "kind", "status", "capturedAt", "finishedAt", "simulator", "app", "launchMode", "didRelaunch", "stateBefore", "stateAfter", "screenBefore", "screenAfter", "visibleElements"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "codex-dock-sim-ui-dump" },
    "status": { "$ref": "#/definitions/status" },
    "reason": { "type": ["string", "null"] },
    "capturedAt": { "type": "string", "minLength": 1 },
    "finishedAt": { "type": "string", "minLength": 1 },
    "simulator": {
      "type": "object",
      "required": ["name", "udid"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "udid": { "type": "string", "minLength": 1 }
      }
    },
    "app": {
      "type": "object",
      "required": ["bundleIdentifier"],
      "additionalProperties": false,
      "properties": {
        "bundleIdentifier": { "type": "string", "minLength": 1 },
        "configuredBuildNumber": { "type": ["string", "null"] }
      }
    },
    "launchMode": { "type": "string", "minLength": 1 },
    "didRelaunch": { "type": "boolean" },
    "stateBefore": { "type": "string" },
    "stateAfter": { "type": "string" },
    "screenBefore": { "enum": ["dock", "thread", "archive", "unknown"] },
    "screenAfter": { "enum": ["dock", "thread", "archive", "unknown"] },
    "activeThreadID": { "type": ["string", "null"] },
    "expectedScreen": { "enum": ["dock", "thread", "archive", "unknown", null] },
    "expectedThreadID": { "type": ["string", "null"] },
    "sampleBefore": { "$ref": "#/definitions/proofValue" },
    "sampleAfter": { "$ref": "#/definitions/proofValue" },
    "visibleElements": {
      "type": "array",
      "items": { "$ref": "#/definitions/proofValue" }
    },
    "rawAccessibilityTree": { "type": ["string", "null"] }
  },
  "definitions": {
    "status": { "enum": ["pass", "fail", "blocked", "not_run"] },
    "proofObjectPropertyName": {
      "anyOf": [
        { "$ref": "https://codex-dock.local/contract/proof/proof-field-name.schema.json" },
        { "$ref": "https://codex-dock.local/contract/proof/proof-route-name.schema.json" }
      ]
    },
    "proofValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/definitions/proofValue" }
        },
        {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/proofObjectPropertyName" },
          "additionalProperties": { "$ref": "#/definitions/proofValue" }
        }
      ]
    }
  }
}
