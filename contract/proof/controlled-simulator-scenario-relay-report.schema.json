{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex-dock.local/contract/proof/controlled-simulator-scenario-relay-report.schema.json",
  "title": "Codex Dock Controlled Simulator Scenario Relay Report",
  "type": "object",
  "required": ["schemaVersion", "kind", "status", "proofRunID", "mode", "scenario", "startedAt", "endedAt", "relayUrl", "summary", "samples", "scenarios", "clientPathEvidence", "findings"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "codex-dock-controlled-simulator-scenario-relay-report" },
    "status": { "$ref": "#/definitions/status" },
    "proofRunID": { "type": "string", "minLength": 1 },
    "mode": { "const": "scenario" },
    "scenario": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "minLength": 1 },
    "endedAt": { "type": "string", "minLength": 1 },
    "relayUrl": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "required": ["ok", "clientPathOK", "scenario", "scenarioOK", "clientPathRouteCounts"],
      "propertyNames": { "$ref": "#/definitions/proofObjectPropertyName" },
      "additionalProperties": { "$ref": "#/definitions/proofValue" },
      "properties": {
        "ok": { "type": "boolean" },
        "clientPathOK": { "type": "boolean" },
        "scenario": { "type": "string" },
        "scenarioOK": { "type": "boolean" },
        "clientPathRouteCounts": {
          "type": "object",
          "propertyNames": { "$ref": "https://codex-dock.local/contract/proof/proof-route-name.schema.json" },
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "samples": {
      "type": "array",
      "items": { "$ref": "#/definitions/proofValue" }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/proofValue" }
    },
    "clientPathEvidence": { "$ref": "#/definitions/clientPathEvidence" },
    "simulatorClientPathEvidence": { "$ref": "#/definitions/clientPathEvidence" },
    "stream": { "$ref": "#/definitions/proofValue" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/proofValue" }
    },
    "unsupportedFacts": {
      "type": "array",
      "items": { "$ref": "#/definitions/proofValue" }
    }
  },
  "definitions": {
    "status": { "enum": ["pass", "fail", "blocked", "not_run"] },
    "proofObjectPropertyName": {
      "anyOf": [
        { "$ref": "https://codex-dock.local/contract/proof/proof-field-name.schema.json" },
        { "$ref": "https://codex-dock.local/contract/proof/proof-route-name.schema.json" }
      ]
    },
    "clientPathEvidence": {
      "type": "object",
      "required": ["routes", "routeCounts"],
      "propertyNames": { "$ref": "#/definitions/proofObjectPropertyName" },
      "additionalProperties": { "$ref": "#/definitions/proofValue" },
      "properties": {
        "routes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "routeCounts": {
          "type": "object",
          "propertyNames": { "$ref": "https://codex-dock.local/contract/proof/proof-route-name.schema.json" },
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "proofValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/definitions/proofValue" }
        },
        {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/proofObjectPropertyName" },
          "additionalProperties": { "$ref": "#/definitions/proofValue" }
        }
      ]
    }
  }
}
