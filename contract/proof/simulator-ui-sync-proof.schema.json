{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex-dock.local/contract/proof/simulator-ui-sync-proof.schema.json",
  "title": "Codex Dock Simulator UI Sync Proof",
  "type": "object",
  "required": ["schemaVersion", "kind", "status", "proofRunID", "startedAt", "endedAt", "relayReport", "summary", "evaluations", "failures"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "codex-dock-simulator-ui-sync-proof" },
    "status": { "$ref": "#/definitions/status" },
    "proofRunID": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "minLength": 1 },
    "endedAt": { "type": "string", "minLength": 1 },
    "relayReport": {
      "type": "object",
      "required": ["relayUrl", "clientPathOK"],
      "additionalProperties": false,
      "properties": {
        "proofRunID": { "type": ["string", "null"] },
        "startedAt": { "type": ["string", "null"] },
        "endedAt": { "type": ["string", "null"] },
        "relayUrl": { "type": ["string", "null"], "minLength": 1 },
        "clientPathOK": { "type": ["boolean", "null"] },
        "clientPathRoutes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "clientPathEvidence": { "$ref": "#/definitions/clientPathEvidence" },
        "routeCounts": {
          "type": "object",
          "propertyNames": { "$ref": "https://codex-dock.local/contract/proof/proof-route-name.schema.json" },
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "config": { "$ref": "#/definitions/proofValue" },
    "summary": {
      "type": "object",
      "required": ["ok", "uiSampleCount", "relaySampleCount", "failures"],
      "propertyNames": { "$ref": "#/definitions/proofObjectPropertyName" },
      "additionalProperties": { "$ref": "#/definitions/proofValue" },
      "properties": {
        "ok": { "type": "boolean" },
        "uiSampleCount": { "type": "number" },
        "relaySampleCount": { "type": "number" },
        "failures": { "type": "number" }
      }
    },
    "evaluations": {
      "type": "array",
      "items": { "$ref": "#/definitions/proofValue" }
    },
    "scenarioTransitionCoverage": { "$ref": "#/definitions/proofValue" },
    "detailTransitionCoverage": { "$ref": "#/definitions/proofValue" },
    "failures": {
      "type": "array",
      "items": { "$ref": "#/definitions/proofValue" }
    }
  },
  "definitions": {
    "status": { "enum": ["pass", "fail", "blocked", "not_run"] },
    "proofObjectPropertyName": {
      "anyOf": [
        { "$ref": "https://codex-dock.local/contract/proof/proof-field-name.schema.json" },
        { "$ref": "https://codex-dock.local/contract/proof/proof-route-name.schema.json" }
      ]
    },
    "clientPathEvidence": {
      "type": "object",
      "required": ["routes", "routeCounts"],
      "propertyNames": { "$ref": "#/definitions/proofObjectPropertyName" },
      "additionalProperties": { "$ref": "#/definitions/proofValue" },
      "properties": {
        "routes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "routeCounts": {
          "type": "object",
          "propertyNames": { "$ref": "https://codex-dock.local/contract/proof/proof-route-name.schema.json" },
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "proofValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/definitions/proofValue" }
        },
        {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/proofObjectPropertyName" },
          "additionalProperties": { "$ref": "#/definitions/proofValue" }
        }
      ]
    }
  }
}
